# Predict-X Environment Configuration Example
# Copy this file to .env and provide your API keys

# Google Gemini API Key for Zero Claw AI Assistant, Decision Explanation & Forensic Classification
VITE_GEMINI_API_KEY=your_gemini_api_key_here

